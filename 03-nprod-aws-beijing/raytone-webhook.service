[Unit]
Description=raytone nprod auto-deploy webhook listener
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
Environment=PORT=9000
ExecStart=/usr/bin/python3 /root/webhook-listener.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
